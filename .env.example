# ---------------------------------------------------------------
# Frontend (Vite) — valores PÚBLICOS. Nunca pongas aquí secretos.
# Supabase → Project Settings → API
# ---------------------------------------------------------------
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Opcional: se muestra en Ajustes → Estado del sistema
VITE_GITHUB_REPO=usuario/linkvault

# ---------------------------------------------------------------
# Edge Functions — SECRETOS. Se configuran en Supabase:
#   Dashboard → Edge Functions → Secrets  (o `supabase secrets set`)
# NO los pongas en .env del frontend ni en el repositorio.
# ---------------------------------------------------------------
# WHATSAPP_VERIFY_TOKEN=una-cadena-larga-que-tu-inventas
# WHATSAPP_APP_SECRET=secreto-de-la-app-de-meta
# WHATSAPP_ACCESS_TOKEN=token-de-acceso-permanente-del-usuario-del-sistema
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WHATSAPP_API_VERSION=v23.0
# ANTHROPIC_API_KEY=sk-ant-...        (opcional: clasificación y resúmenes con IA)
# AI_MODEL=claude-haiku-5-5            (opcional)
